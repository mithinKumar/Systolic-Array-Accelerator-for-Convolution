# Systolic Array Accelerator - Environment Configuration Example

# Logging Configuration
# Supported levels: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Simulation Matrix Parameters
SIM_INPUT_ROWS=4
SIM_INPUT_COLS=4
SIM_FILTER_SIZE=2
SIM_NUM_FILTERS=2

# Build Environment
CC=gcc
CFLAGS=-Wall -Wextra -std=c99 -pedantic
